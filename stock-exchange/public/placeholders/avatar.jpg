<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 120 120" width="120" height="120">
  <defs>
    <linearGradient id="avatarBg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#059669" />
      <stop offset="100%" stop-color="#0d9488" />
    </linearGradient>
    <linearGradient id="avatarFigure" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#ffffff" stop-opacity="0.95" />
      <stop offset="100%" stop-color="#f0fdf4" stop-opacity="0.9" />
    </linearGradient>
  </defs>
  <rect width="120" height="120" rx="30" fill="url(#avatarBg)" />
  <!-- Head -->
  <circle cx="60" cy="46" r="19" fill="url(#avatarFigure)" />
  <!-- Shoulders / Torso -->
  <path d="M28 100 C28 78 42 72 60 72 C78 72 92 78 92 100 Z" fill="url(#avatarFigure)" />
</svg>
